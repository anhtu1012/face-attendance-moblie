{
  "expo": {
    "name": "Face Attendance Mobile",
    "slug": "face-attendance-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.png",
    "scheme": "faceattendancemobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "$(PRODUCT_NAME) needs access to your Camera."
      },
      "bundleIdentifier": "com.huangphucc.faceattendancemobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3674B5",
        "foregroundImage": "./assets/images/app-logo.png",
        "backgroundImage": "./assets/images/app-logo.png",
        "monochromeImage": "./assets/images/app-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.huangphucc.faceattendancemobile",
      "googleServicesFile": "./google-services.json",
      "permissions": ["android.permission.CAMERA", "android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "$(PRODUCT_NAME) needs access to your Camera."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3674B5",
          "dark": {
            "backgroundColor": "#3674B5"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e0e0287-1ca0-45b1-b4cc-40be5f9b31e8"
      }
    },
    "owner": "huangphucc",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3e0e0287-1ca0-45b1-b4cc-40be5f9b31e8"
    }
  }
}
