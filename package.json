{
  "name": "face-attendance-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start -c",
    "start:no-dev": "expo start -c --no-dev --minify",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:development:android": "eas build --profile development --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:all": "eas build --profile preview --platform all",
    "build:production:android": "eas build --profile production --platform android",
    "build:production:ios": "eas build --profile production --platform ios",
    "build:apk:local": "cd android && ./gradlew assembleRelease",
    "install:apk:local": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "rebuild:assets": "bash ./scripts/rebuild-assets.sh",
    "rebuild:assets:install": "bash ./scripts/rebuild-assets.sh && adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "check-build": "bash ./scripts/check-build-env.sh",
    "verify-firebase": "bash ./scripts/verify-firebase-config.sh",
    "prebuild": "npx expo prebuild",
    "prebuild:clean": "npx expo prebuild --clean"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/hooks": "^100.1.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/material-top-tabs": "^7.3.7",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-query": "^5.90.2",
    "@types/react-redux": "^7.1.34",
    "axios": "^1.11.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.18",
    "expo": "54.0.21",
    "expo-brightness": "~14.0.7",
    "expo-build-properties": "~1.0.9",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.16",
    "expo-device": "~8.0.8",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.7",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^15.0.6",
    "expo-linking": "~8.0.7",
    "expo-local-authentication": "~17.0.7",
    "expo-notifications": "~0.32.11",
    "expo-router": "~6.0.14",
    "expo-splash-screen": "~31.0.8",
    "expo-status-bar": "~3.0.7",
    "expo-symbols": "~1.0.6",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.12",
    "expo-web-browser": "~15.0.6",
    "formik": "^2.4.6",
    "lucide-react-native": "^0.548.0",
    "moti": "^0.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-notificated": "^0.1.7",
    "react-native-pager-view": "^6.9.1",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-signature-canvas": "^5.0.1",
    "react-native-svg": "^15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-vision-camera": "^4.5.2",
    "react-native-vision-camera-face-detector": "^1.8.9",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "1.6.2",
    "react-native-zip-archive": "^7.0.2",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "latest",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "reactotron-react-native": "^5.1.17",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fs",
          "react-native-zip-archive"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
